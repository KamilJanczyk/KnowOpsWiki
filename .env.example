# Plik przykładowy środowiska
# Skopiuj ten plik jako .env i dostosuj wartości
API_PORT=9000
# Hasło główne administratora (brak hasła = tryb otwarty bezhasłowy)
ADMIN_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
# Czas trwania sesji po zalogowaniu w godzinach (domyślnie 6)
SESSION_HOURS=6
WIKI_PORT=8085

# Automatyczne codzienne kopie zapasowe
BACKUP_AUTO_ENABLED=true
# Godzina codziennej kopii zapasowej w formacie HH:MM (domyślnie 22:00)
BACKUP_SCHEDULE_TIME=22:00
# Retencja: liczba przechowywanych najnowszych kopii (domyślnie 7)
BACKUP_KEEP_COUNT=7
# Strefa czasowa dla harmonogramu (domyślnie Europe/Warsaw)
TZ=Europe/Warsaw
